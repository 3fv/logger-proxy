{
  "name": "@3fv/logger-proxy",
  "version": "1.0.73",
  "packageManager": "pnpm@12.15.0",
  "description": "A logger proxy to enable hot swapping backends",
  "main": "./lib/cjs/index.js",
  "module": "./lib/mjs/index.js",
  "types": "./lib/mjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/mjs/index.d.ts",
        "default": "./lib/mjs/index.js"
      },
      "require": {
        "types": "./lib/cjs/index-node.d.ts",
        "default": "./lib/cjs/index-node.js"
      }
    },
    "./context/providers/node": {
      "import": {
        "types": "./lib/mjs/context/providers/node/index.d.ts",
        "default": "./lib/mjs/context/providers/node/index.js"
      },
      "require": {
        "types": "./lib/cjs/context/providers/node/index.d.ts",
        "default": "./lib/cjs/context/providers/node/index.js"
      }
    },
    "./appenders/FileAppender.js": {
      "import": {
        "types": "./lib/mjs/appenders/FileAppender.d.ts",
        "default": "./lib/mjs/appenders/FileAppender.js"
      },
      "require": {
        "types": "./lib/cjs/appenders/FileAppender.d.ts",
        "default": "./lib/cjs/appenders/FileAppender.js"
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:watch": "pnpm run build --watch",
    "test": "jest",
    "test:watch": "jest --watchAll --no-cache",
    "test:dev": "run-s build && run-p test:watch build:watch",
    "preversion": "pnpm build && pnpm test",
    "release": "gh workflow run release.yml --ref master -f bump=patch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3fv/logger-proxy.git"
  },
  "keywords": [
    "typescript",
    "logger",
    "proxy"
  ],
  "files": [
    "lib",
    "!lib/**/*.spec.*",
    "!lib/**/*.tsbuildinfo",
    "src",
    "!src/**/*.spec.ts",
    "README.md"
  ],
  "author": "Jonathan Glanz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/3fv/logger-proxy/issues"
  },
  "homepage": "https://github.com/3fv/logger-proxy#readme",
  "dependencies": {
    "@3fv/deferred": "^1.2.17",
    "@3fv/guard": "^1.4.41",
    "@3fv/prelude-ts": "^0.8.45",
    "bluebird": "^3.7.2",
    "chalk": "^5.3.0",
    "debug": "^4.3.6",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bluebird": "^3.5.42",
    "@types/chalk": "^2.2.0",
    "@types/debug": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.4.0",
    "@types/shelljs": "^0.8.15",
    "cross-env": "^7.0.3",
    "electron": "^30",
    "jest": "^30.5.2",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "semver": "^7.6.3",
    "shelljs": "^0.8.5",
    "source-map-support": "^0.5.21",
    "supports-color": "^9.4.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zx": "^8.1.4"
  }
}
